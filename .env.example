# Variables de entorno para el frontend de Shopersa (React + Vite)

# Base URL del backend (incluye /api si corresponde)
VITE_API_BASE_URL=http://localhost:8080/api

# Opcional: habilitar modo debug en API client
VITE_API_DEBUG=false

# Opcional: prefijo para storage de Auth
VITE_AUTH_STORAGE_KEY=SHOPERSA

# Modo de autenticación
# Cuando es true, la app requiere JWT para considerar la sesión válida.
# Cuando es false, la app permite sesión sin token (solo con datos de usuario).
VITE_AUTH_REQUIRE_JWT=false